Port=5000
ADMIN_BOOTSTRAP_SECRET=
JWT_SECRET=change-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-backend-supabase-service-role-or-secret-key
SUPABASE_ANON_KEY=your-frontend-publishable-or-anon-key

# Cloudflare R2 (server-side only; never expose these values to the frontend)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
